  "privacyTitle": "Privacy & Terms",
  "privacySummaryTitle": "Plain English Summary",
  "privacySummaryItem1": "DealSouk helps shoppers compare grocery prices using community-submitted prices.",
  "privacySummaryItem2": "We ask for only the information needed to run the app: your account, home area, language, submissions, requests, tokens, and moderation history.",
  "privacySummaryItem3": "We use your device location only to show nearby supermarket prices. Precise GPS is not stored permanently.",
  "privacySummaryItem4": "Tokens are rewards inside DealSouk. They are not cash, cannot be transferred, and cannot be sold.",
  "privacySummaryItem5": "Photos are used to verify price labels or receipts. Do not upload photos with personal information.",
  "privacySummaryItem6": "You can request account deletion from Profile settings.",
  "privacyCollectTitle": "What We Collect",
  "privacyCollectItem1": "Account details: Firebase account ID, display name, phone number if you use phone login, and preferred language.",
  "privacyCollectItem2": "Shopping area: neighbourhood or area, not a permanent precise GPS record.",
  "privacyCollectItem3": "Price data: products, stores, prices, timestamps, optional shelf label or receipt photos, and moderation flags.",
  "privacyCollectItem4": "Rewards data: token balance, token history, voucher requests, badges, streaks, and leaderboard totals.",
  "privacyCollectItem5": "Device messaging token: used only for DealSouk notifications such as request fulfilment or reward updates.",
  "privacyUseTitle": "How We Use Data",
  "privacyUseItem1": "To show fresh prices near you.",
  "privacyUseItem2": "To calculate savings, requests, tokens, and rewards.",
  "privacyUseItem3": "To detect wrong, stale, duplicate, or suspicious submissions.",
  "privacyUseItem4": "To operate admin moderation and voucher approval.",
  "privacyUseItem5": "To improve reliability, security, and Arabic/English usability.",
  "privacyChoicesTitle": "Your Choices",
  "privacyChoicesItem1": "You may browse as a guest with limited features.",
  "privacyChoicesItem2": "You can change your display name, home area, and language.",
  "privacyChoicesItem3": "You can deny location access and still use non-location features.",
  "privacyChoicesItem4": "You can request account deletion. We anonymise account data needed for fraud prevention and financial/reward audit records.",
  "privacyArabicTitle": "Arabic Summary",
  "privacyArabicItem1": "We use your location only to show nearby store prices, and we do not permanently store precise GPS location.",
  "privacyArabicItem2": "Tokens are in-app rewards, not cash, and cannot be sold or transferred.",
