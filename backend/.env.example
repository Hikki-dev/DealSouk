DATABASE_URL=postgresql://user:password@localhost:5432/dealsouk
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
REDIS_URL=redis://localhost:6379
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:5173
JSON_BODY_LIMIT=1mb
GLOBAL_RATE_LIMIT_PER_MINUTE=120
SUBMISSION_RATE_LIMIT_PER_MINUTE=5
REQUEST_RATE_LIMIT_PER_MINUTE=10
ADMIN_RATE_LIMIT_PER_MINUTE=60
DATABASE_ENCRYPTION_KEY=replace-with-32-plus-random-characters
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=DealSouk is undergoing scheduled maintenance. Some features may be unavailable.
