{
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- lib web assets pubspec.yaml pubspec.lock l10n.yaml vercel_build.sh vercel.json",
  "buildCommand": "bash ./vercel_build.sh",
  "outputDirectory": "build/web",
  "installCommand": "echo 'skip npm install'",
  "framework": null,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/flutter_service_worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
