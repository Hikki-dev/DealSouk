NODE_ENV=production
DATABASE_URL=REPLACE_WITH_NEON_POSTGRES_URL
DATABASE_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32
FIREBASE_PROJECT_ID=dealsouk-6e140
FIREBASE_CLIENT_EMAIL=REPLACE_WITH_FIREBASE_SERVICE_ACCOUNT_EMAIL
FIREBASE_PRIVATE_KEY=REPLACE_WITH_ESCAPED_FIREBASE_PRIVATE_KEY
ALLOWED_ORIGINS=https://deal-souk.vercel.app
JSON_BODY_LIMIT=1mb
# Optional. When set, Redis backs shared rate-limiting + leaderboard cache so
# limits and caches hold across horizontally-scaled instances (NFR-05). Leave
# unset to use per-instance in-memory fallbacks. Use an Upstash rediss:// URL.
REDIS_URL=
GLOBAL_RATE_LIMIT_PER_MINUTE=120
AUTH_VERIFY_RATE_LIMIT_PER_MINUTE=30
SUBMISSION_RATE_LIMIT_PER_MINUTE=5
FLAG_RATE_LIMIT_PER_MINUTE=10
REQUEST_RATE_LIMIT_PER_MINUTE=10
REQUEST_FULFILL_RATE_LIMIT_PER_MINUTE=10
ADMIN_RATE_LIMIT_PER_MINUTE=60
PROFILE_WRITE_RATE_LIMIT_PER_MINUTE=20
FCM_TOKEN_RATE_LIMIT_PER_MINUTE=10
CART_SYNC_RATE_LIMIT_PER_MINUTE=20
ACCOUNT_DELETE_RATE_LIMIT_PER_MINUTE=3
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=DealSouk is undergoing scheduled maintenance. Some features may be unavailable.
