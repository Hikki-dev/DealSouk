generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String    @id @default(cuid())
  firebaseUid          String    @unique
  displayName          String
  avatarUrl            String?
  phoneNumber          String?   @unique
  homeArea             String?
  preferredLocale      String    @default("en")
  tokenBalance         Int       @default(0)
  accuracyRating       Float     @default(100.0)
  isSuspended          Boolean   @default(false)
  suspendedUntil       DateTime?
  suspensionCount      Int       @default(0)
  warningCount         Int       @default(0)
  bannedAt             DateTime?
  banReason            String?
  isAdmin              Boolean   @default(false)
  fcmToken             String?
  currentStreak        Int       @default(0)
  longestStreak        Int       @default(0)
  lastSubmissionDate   DateTime?
  lifetimeTokensEarned Int       @default(0)
  level                Int       @default(1)
  createdAt            DateTime  @default(now())

  submissions     PriceSubmission[]
  tokenLedger     TokenTransaction[]
  requests        PriceRequest[]
  vouchers        VoucherRequest[]
  badges          UserBadge[]
  flags           SubmissionFlag[]
  cartItems       CartItem[]
  dailyChallenges UserDailyChallenge[]
  adminActions    AdminUserAction[] @relation("AdminActionTarget")
  issuedActions   AdminUserAction[] @relation("AdminActionActor")
}

model Store {
  id         String @id @default(cuid())
  chain      String
  branchName String
  area       String
  lat        Float
  lng        Float

  submissions PriceSubmission[]

  @@index([chain])
  @@index([lat, lng])
}

model Product {
  id       String  @id @default(cuid())
  name     String
  brand    String?
  packSize String?
  category String
  imageUrl String?
  barcode  String? @unique

  submissions PriceSubmission[]
  cartItems   CartItem[]

  @@index([name])
  @@index([category])
  @@index([barcode])
}

model PriceSubmission {
  id            String   @id @default(cuid())
  productId     String
  storeId       String
  sourcerId     String
  priceAed      Decimal  @db.Decimal(10, 2)
  hasReceipt    Boolean  @default(false)
  receiptUrl    String?
  status        String   @default("pending") // pending | approved | rejected | hidden
  flagCount     Int      @default(0)
  tokensAwarded Int      @default(0)
  submittedAt   DateTime @default(now())
  expiresAt     DateTime

  product Product          @relation(fields: [productId], references: [id])
  store   Store            @relation(fields: [storeId], references: [id])
  sourcer User             @relation(fields: [sourcerId], references: [id])
  flags   SubmissionFlag[]

  @@index([productId, storeId, submittedAt])
  @@index([status, submittedAt])
  @@index([sourcerId])
}

model SubmissionFlag {
  id           String   @id @default(cuid())
  submissionId String
  flaggerId    String
  reason       String // "price_wrong" | "product_mismatch" | "store_wrong" | "duplicate"
  createdAt    DateTime @default(now())

  submission PriceSubmission @relation(fields: [submissionId], references: [id])
  flagger    User            @relation(fields: [flaggerId], references: [id])

  @@unique([submissionId, flaggerId])
}

model TokenTransaction {
  id        String   @id @default(cuid())
  userId    String
  amount    Int // positive = earn, negative = spend
  reason    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model VoucherRequest {
  id             String    @id @default(cuid())
  userId         String
  status         String    @default("pending") // pending | approved | rejected
  thresholdTokens Int
  tokenCost      Int
  denominationAed Int     @default(50)
  supermarket    String
  voucherCode    String?
  adminNote      String?
  requestedAt    DateTime @default(now())
  reviewedAt     DateTime?
  deliveredAt    DateTime?

  user User @relation(fields: [userId], references: [id])
  voucherInventory VoucherInventory?

  @@index([status, requestedAt])
  @@index([userId, status])
}

model VoucherInventory {
  id               String    @id @default(cuid())
  supermarket      String    // e.g. "Carrefour", "Lulu", "Spinneys"
  denominationAed  Int       @default(50)
  code             String    @unique
  isUsed           Boolean   @default(false)
  importedAt       DateTime  @default(now())
  usedAt           DateTime?
  voucherRequestId String?   @unique

  voucherRequest   VoucherRequest? @relation(fields: [voucherRequestId], references: [id])

  @@index([supermarket, denominationAed, isUsed])
}

model PriceRequest {
  id           String   @id @default(cuid())
  requesterId  String
  productName  String
  storeName    String
  bountyTokens Int
  status       String   @default("open") // open | fulfilled | expired | refunded
  fulfilledBy  String?
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  requester User @relation(fields: [requesterId], references: [id])

  @@index([status, bountyTokens])
  @@index([requesterId])
}

model Badge {
  id          String @id
  name        String
  emoji       String
  description String

  userBadges UserBadge[]
}

model UserBadge {
  userId     String
  badgeId    String
  unlockedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  badge Badge @relation(fields: [badgeId], references: [id])

  @@id([userId, badgeId])
}

model AdminSettings {
  id                 Int   @id @default(1) // singleton row
  tokenEarnRate      Int   @default(50)
  voucherThreshold   Int   @default(500)
  dailySubmissionCap Int   @default(30)
  requestCostTokens  Int   @default(10)
  decayFactor        Float @default(0.7) // multiplier when duplicate nearby submission exists
}

model AdminUserAction {
  id          String   @id @default(cuid())
  targetUserId String
  adminUserId  String
  action      String   // warn | suspend | ban
  reason      String
  createdAt   DateTime @default(now())
  expiresAt   DateTime?

  targetUser User @relation("AdminActionTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  adminUser  User @relation("AdminActionActor", fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([targetUserId, createdAt])
  @@index([action, createdAt])
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  quantity  Int      @default(1)
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
  @@index([userId])
}

model DailyChallenge {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  title       String
  description String
  chainTarget String?
  areaTarget  String?
  targetCount Int      @default(5)
  bonusTokens Int      @default(100)

  userProgress UserDailyChallenge[]

  @@unique([date])
}

model UserDailyChallenge {
  id           String    @id @default(cuid())
  userId       String
  challengeId  String
  progress     Int       @default(0)
  completed    Boolean   @default(false)
  completedAt  DateTime?
  bonusAwarded Boolean   @default(false)

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge DailyChallenge @relation(fields: [challengeId], references: [id])

  @@unique([userId, challengeId])
  @@index([userId])
}
