{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    // Prod build only needs node globals (jest is dev-only and omitted from
    // production installs). Module types (express, cors, …) resolve on import.
    // Tests get jest globals via tsconfig.test.json. Restricting the list also
    // stops TS implicitly loading every @types/* and erroring on phantom ones.
    "types": ["node", "cors", "express"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
