DATABASE_URL=REPLACE_WITH_LOCAL_OR_NEON_POSTGRES_URL
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=REPLACE_WITH_FIREBASE_SERVICE_ACCOUNT_EMAIL
FIREBASE_PRIVATE_KEY=REPLACE_WITH_ESCAPED_FIREBASE_PRIVATE_KEY
REDIS_URL=redis://localhost:6379
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:5173
JSON_BODY_LIMIT=1mb
GLOBAL_RATE_LIMIT_PER_MINUTE=120
AUTH_VERIFY_RATE_LIMIT_PER_MINUTE=30
SUBMISSION_RATE_LIMIT_PER_MINUTE=5
SEARCH_RATE_LIMIT_PER_MINUTE=30
FLAG_RATE_LIMIT_PER_MINUTE=10
REQUEST_RATE_LIMIT_PER_MINUTE=10
REQUEST_FULFILL_RATE_LIMIT_PER_MINUTE=10
ADMIN_RATE_LIMIT_PER_MINUTE=60
PROFILE_WRITE_RATE_LIMIT_PER_MINUTE=20
FCM_TOKEN_RATE_LIMIT_PER_MINUTE=10
CART_SYNC_RATE_LIMIT_PER_MINUTE=20
ACCOUNT_DELETE_RATE_LIMIT_PER_MINUTE=3
DATABASE_ENCRYPTION_KEY=replace-with-32-plus-random-characters
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=DealSouk is undergoing scheduled maintenance. Some features may be unavailable.
MAINTENANCE_INTERVAL_MINUTES=60

# Set to true to require MFA for admin API access
ADMIN_MFA_REQUIRED=false

# Set to true so anyone signed in can look around the moderator console, read-only.
# Only users with isAdmin (npm run admin:set) can change anything. See docs/Demo mode.md
ADMIN_DEMO_VIEWERS=false
# Also show other shoppers' receipt photos to demo viewers (default: hidden)
ADMIN_DEMO_SHOW_PHOTOS=false

# Set to true and provide REDIS_URL to use Redis-backed rate limiting (recommended in production)
RATE_LIMIT_REDIS=false

# Google Translate API key (required for /translate endpoint)
GOOGLE_TRANSLATE_API_KEY=REPLACE_WITH_GOOGLE_TRANSLATE_API_KEY

# SMTP email settings (optional — console logs if not set in development)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@dealsouk.com
